---
// Variant 1, "Proof first". Axis: layout. The product is the visual; the headline sits beside a real, playing clip of Tetsu's import.
import { Image } from 'astro:assets';
import headshot from '../../assets/david-salazar-headshot.jpg';
---

<section class="hv hv-proof">
  <div class="col hv-proof-grid">
    <div class="hv-proof-text">
      <h1>Clear requirements from messy problems.</h1>
      <p class="hv-lead">
        I do business analysis and project coordination, currently as a consultant at FDM Group. I
        write requirements and acceptance criteria, and I build prototypes with AI and check them
        against those requirements and tests.
      </p>
      <div class="actions">
        <a class="btn" href="/work/tetsu/">Read the Tetsu case study</a>
        <a class="btn soft" href="/David_Salazar_Resume.pdf">Resume (PDF)</a>
        <a class="textlink" href="mailto:davesal0710@gmail.com">Email me</a>
      </div>
      <div class="who hv-who">
        <Image src={headshot} alt="" width={48} height={48} densities={[1, 2]} loading="eager" />
        <p>
          <strong>David Salazar</strong>
          New York · open to business analyst, implementation and automation roles
        </p>
      </div>
    </div>
    <a class="hv-proof-phone" href="/work/tetsu/">
      <img src="/tetsu-import.gif" width="320" height="696" alt="Tetsu’s import screen: a pasted routine is organized, then shown on a review screen before anything is replaced" />
      <span>Tetsu, my workout app. Paste a routine, review it, then save.</span>
    </a>
  </div>
</section>

<style is:global>
  .hv-proof {
    padding-block: clamp(2rem, 7vh, 4.5rem) 3rem;
  }
  .hv-proof-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .hv-proof h1 {
    font-size: clamp(2.25rem, 1.3rem + 3.2vw, 3.75rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
    max-width: 11em;
    margin: 0 0 1.25rem;
  }
  .hv-lead {
    max-width: 30rem;
    margin: 0;
  }
  .hv-who {
    margin: 2rem 0 0;
  }
  .hv-proof-phone {
    display: block;
    width: min(100%, 17rem);
    color: inherit;
    text-decoration: none;
    justify-self: center;
  }
  .hv-proof-phone img {
    display: block;
    width: 100%;
    height: auto;
    border: 6px solid var(--surface);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .hv-proof-phone span {
    display: block;
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: var(--step-small);
    line-height: 1.4;
  }
  @media (min-width: 64rem) {
    .hv-proof-grid {
      grid-template-columns: minmax(0, 1fr) 19rem;
      column-gap: 6rem;
    }
    .hv-proof-phone {
      width: 19rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hv-proof-text > *,
    .hv-proof-phone {
      animation: hv-rise 600ms var(--ease-out) both;
    }
    .hv-proof-text > :nth-child(2) { animation-delay: 60ms; }
    .hv-proof-text > :nth-child(3) { animation-delay: 120ms; }
    .hv-proof-text > :nth-child(4) { animation-delay: 180ms; }
    .hv-proof-phone { animation-delay: 140ms; }
    @keyframes hv-rise {
      from { opacity: 0; transform: translateY(10px); }
    }
  }
</style>
