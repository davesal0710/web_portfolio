---
// Variant 3, "Quiet". Axis: density and personality. One person, one sentence, one button. Everything else waits below the fold.
import { Image } from 'astro:assets';
import headshot from '../../assets/david-salazar-headshot.jpg';
---

<section class="hv hv-quiet">
  <div class="col hv-quiet-inner">
    <Image class="hv-quiet-face" src={headshot} alt="David Salazar" width={176} height={176} densities={[1, 2]} loading="eager" />
    <div>
      <p class="hv-quiet-name">David Salazar · New York</p>
      <h1>Clear requirements from messy problems.</h1>
      <p class="hv-quiet-lead">
        I’m a consultant at FDM Group. I write requirements and acceptance criteria, and I build
        working prototypes with AI. I’m looking for business analyst, implementation and workflow
        automation roles.
      </p>
      <div class="actions">
        <a class="btn" href="/work/tetsu/">Read the Tetsu case study</a>
        <a class="textlink" href="/David_Salazar_Resume.pdf">Resume (PDF)</a>
        <a class="textlink" href="mailto:davesal0710@gmail.com">Email me</a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .hv-quiet {
    display: flex;
    align-items: center;
    min-height: calc(100dvh - var(--nav-h) - 6rem);
    padding-block: 2rem;
  }
  .hv-quiet-inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .hv-quiet-face {
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 50%;
    object-fit: cover;
    filter: saturate(0.94) sepia(0.06);
  }
  .hv-quiet-name {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: var(--step-small);
  }
  .hv-quiet h1 {
    font-size: clamp(2.5rem, 1.2rem + 5vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    max-width: 10em;
    margin: 0 0 1.5rem;
  }
  .hv-quiet-lead {
    max-width: 30rem;
    margin: 0;
  }
  @media (min-width: 64rem) {
    .hv-quiet-inner {
      grid-template-columns: 11rem minmax(0, 1fr);
      column-gap: 4rem;
    }
    .hv-quiet-face {
      width: 11rem;
      height: 11rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hv-quiet-face,
    .hv-quiet-inner > div > * {
      animation: hv-rise-q 800ms var(--ease-out) both;
    }
    .hv-quiet-inner > div > :nth-child(2) { animation-delay: 80ms; }
    .hv-quiet-inner > div > :nth-child(3) { animation-delay: 160ms; }
    .hv-quiet-inner > div > :nth-child(4) { animation-delay: 240ms; }
    @keyframes hv-rise-q {
      from { opacity: 0; transform: translateY(8px); }
    }
  }
</style>
