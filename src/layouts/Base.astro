---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  current?: 'intro' | 'work' | 'about' | 'contact';
}
const { title, description, current } = Astro.props;
const home = Astro.url.pathname === '/';
const prefix = home ? '' : '/';
const tabs = [
  { id: 'intro', label: 'intro', href: home ? '#top' : '/' },
  { id: 'work', label: 'work', href: `${prefix}#work` },
  { id: 'about', label: 'about', href: `${prefix}#about` },
  { id: 'contact', label: 'contact', href: `${prefix}#contact` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#ebe6db" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/switzer-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/switzer-500.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav-bar">
      <nav class="col" aria-label="Main">
        <div class="tabs" data-tabs>
          <span class="pill" aria-hidden="true"></span>
          {tabs.map((t) => (
            <a href={t.href} data-tab={t.id} aria-current={t.id === current ? 'true' : undefined}>
              {t.label}
            </a>
          ))}
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="col">
        <p>David Salazar, New York</p>
      </div>
    </footer>
    <script define:vars={{ home }}>
      const tabs = document.querySelector('[data-tabs]');
      const pill = tabs.querySelector('.pill');
      const links = [...tabs.querySelectorAll('a')];

      function select(id) {
        links.forEach((a) => {
          if (a.dataset.tab === id) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
        const a = links.find((l) => l.dataset.tab === id);
        if (!a) return;
        tabs.style.setProperty('--x', a.offsetLeft + 'px');
        tabs.style.setProperty('--s', String(a.offsetWidth / 100));
      }
      const active = () => links.find((a) => a.hasAttribute('aria-current'))?.dataset.tab;

      select(active() ?? 'work');
      requestAnimationFrame(() => pill.classList.add('ready'));
      addEventListener('resize', () => select(active()));
      document.fonts?.ready.then(() => select(active()));

      const io = 'IntersectionObserver' in window ? new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px' }) : null;
      document.querySelectorAll('section, header.case-head').forEach((sec) => {
        sec.querySelectorAll('[data-reveal]').forEach((el, i) => {
          el.style.setProperty('--d', Math.min(i, 5) * 70 + 'ms');
          if (!io || el.getBoundingClientRect().top < innerHeight * 0.9) {
            el.style.transition = 'none';
            el.classList.add('in');
          } else io.observe(el);
        });
      });

      if (home) {
        const ids = ['intro', 'work', 'about', 'contact'];
        const sections = ids.map((id) => document.getElementById(id === 'intro' ? 'top' : id));
        const onScroll = () => {
          const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
          let current = 'intro';
          if (atBottom) current = 'contact';
          else {
            const line = scrollY + innerHeight * 0.35;
            sections.forEach((s, i) => {
              if (i > 0 && s && s.offsetTop <= line) current = ids[i];
            });
          }
          if (current !== active()) select(current);
        };
        addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
    </script>
  </body>
</html>
