---
import '../styles/global.css';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description: string;
  current?: 'intro' | 'work' | 'about' | 'contact';
}
const { title, description, current } = Astro.props;
const home = Astro.url.pathname === '/';
const ogImage = new URL('/og.png', Astro.site).href;
const prefix = home ? '' : '/';
const tabs = [
  { id: 'intro', label: 'intro', href: home ? '#top' : '/' },
  { id: 'work', label: 'work', href: `${prefix}#work` },
  { id: 'about', label: 'about', href: `${prefix}#about` },
  { id: 'contact', label: 'contact', href: `${prefix}#contact` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f8efe3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/switzer-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cabinet-500.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body id="top">
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav-bar">
      <nav class="col" aria-label="Main">
        <div class="tabs" data-tabs>
          <span class="pill" aria-hidden="true"></span>
          {tabs.map((t) => (
            <a href={t.href} data-tab={t.id} aria-current={t.id === current ? 'true' : undefined}>
              {t.label}
            </a>
          ))}
        </div>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <div class="col">
        <p>David Salazar, New York</p>
      </div>
    </footer>
    <script define:vars={{ home }}>
      const tabs = document.querySelector('[data-tabs]');
      const pill = tabs.querySelector('.pill');
      const links = [...tabs.querySelectorAll('a')];

      function select(id) {
        links.forEach((a) => {
          if (a.dataset.tab === id) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
        const a = links.find((l) => l.dataset.tab === id);
        if (!a) return;
        pill.style.transform = `translateX(${a.offsetLeft}px) scaleX(${a.offsetWidth / 100})`;
        // keep the active tab in view when the bar scrolls (big text, tiny screens)
        if (tabs.scrollWidth > tabs.clientWidth) tabs.scrollTo({ left: Math.max(0, a.offsetLeft - 8), behavior: 'auto' });
      }
      const active = () => links.find((a) => a.hasAttribute('aria-current'))?.dataset.tab;

      select(active() ?? 'work');
      requestAnimationFrame(() => pill.classList.add('ready'));
      addEventListener('resize', () => select(active()));
      document.fonts?.ready.then(() => select(active()));

      const io = 'IntersectionObserver' in window ? new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px' }) : null;
      document.querySelectorAll('section, header.case-head').forEach((sec) => {
        sec.querySelectorAll('[data-reveal]').forEach((el, i) => {
          el.style.setProperty('--d', Math.min(i, 3) * 60 + 'ms');
          if (!io || el.getBoundingClientRect().top < innerHeight * 0.9) {
            el.style.transition = 'none';
            el.classList.add('in');
          } else io.observe(el);
        });
      });

      // Scroll progress for the page warmth, only where CSS scroll-driven animation is missing (Firefox, older Safari).
      if (!CSS.supports('animation-timeline: scroll()')) {
        let queued = false;
        const root = document.documentElement;
        const update = () => {
          queued = false;
          const max = root.scrollHeight - innerHeight;
          root.style.setProperty('--p', max > 0 ? String(Math.min(1, Math.max(0, scrollY / max))) : '0');
        };
        addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
        update();
      }

      // Scroll-spy without reading layout on every scroll: a thin band at 35% of the viewport.
      if (home && 'IntersectionObserver' in window) {
        const spy = new IntersectionObserver((es) => {
          es.forEach((e) => { if (e.isIntersecting) select(e.target.id); });
        }, { rootMargin: '-35% 0px -60% 0px' });
        ['intro', 'work', 'about', 'contact'].forEach((id) => {
          const el = document.getElementById(id);
          if (el) spy.observe(el);
        });
        const foot = document.querySelector('footer');
        if (foot) new IntersectionObserver((es) => { if (es[0].isIntersecting) select('contact'); }).observe(foot);
      }
    </script>
    <Lightbox />
  </body>
</html>
